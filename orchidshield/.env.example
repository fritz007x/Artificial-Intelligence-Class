# Copy to .env and fill in. NEVER commit .env. Generate keys with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Least-privilege API keys (one per role)
ORCHIDSHIELD_OPERATOR_KEY=
ORCHIDSHIELD_APPROVER_KEY=
ORCHIDSHIELD_ADMIN_KEY=
# dev | staging | prod   (prod refuses ORCHIDSHIELD_DEV_OPEN)
ORCHIDSHIELD_ENV=dev
# Local demo only: 1 disables API-key auth (refused when ORCHIDSHIELD_ENV=prod)
ORCHIDSHIELD_DEV_OPEN=0
# Emergency stop without the API: 1 halts the agent loop and all tool calls
ORCHIDSHIELD_KILL_SWITCH=0
# Optional alternate config file (non-secret)
# ORCHIDSHIELD_CONFIG=/app/configs/config.yaml
# Optional: hosted narrator (features.llm_narrative: true). Leave empty to use the deterministic template.
ANTHROPIC_API_KEY=
